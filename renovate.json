{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "flux": {
    "managerFilePatterns": ["/k8s/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/k8s/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Ignore docker image updates in flux-managed gotk-components manifest — flux manager handles these holistically",
      "matchManagers": ["docker-compose", "dockerfile", "kubernetes"],
      "matchFileNames": ["k8s/flux-system/gotk-components.yaml"],
      "enabled": false
    }
  ]
}
